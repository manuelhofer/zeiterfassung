# Lokale Konfiguration mit echten Zugangsdaten (Vorlage: config/config.php.example)
config/config.local.php

# Geraetelokale Einstellungen eines Terminals (lokale Ausweichdatenbank,
# RFID-Bridge). Legt das Installationsskript an, die Einrichtungsseite liest
# sie beim Koppeln aus. Gehoert zur Maschine, nicht zum Quellcode.
config/geraet.local.php

# Antwortdatei des Terminal-Installationsskripts (Vorlage:
# scripts/terminal/terminal.conf.example). Sie beschreibt ein konkretes Geraet
# bzw. eine konkrete Serie und gehoert nicht ins Repository.
scripts/terminal/terminal.conf

# Zur Laufzeit erzeugte Dateien.
# Die Verzeichnisse selbst bleiben im Repo (.gitkeep), ihr Inhalt entsteht erst
# im Betrieb: Maschinen-QR-Codes und -Barcodes werden beim Speichern einer
# Maschine geschrieben und gehoeren zur Installation, nicht zum Quellcode.
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/maschinen_codes/
public/uploads/maschinen_codes/*
!public/uploads/maschinen_codes/.gitkeep
