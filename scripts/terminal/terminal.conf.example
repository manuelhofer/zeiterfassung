# ===========================================================================
#  Antwortdatei fuer install_terminal.sh (Stufe 3) und install_kiosk.sh
#  (Stufe 4)
# ===========================================================================
#
#  Nutzung:
#      cp terminal.conf.example terminal.conf
#      # anpassen
#      sudo ./install_terminal.sh
#      sudo ./install_kiosk.sh
#
#  Beide Skripte lesen dieselbe Datei; jedes nimmt sich, was es braucht.
#
#  Ohne diese Datei fragt das Skript nach, sofern jemand davorsitzt, und nimmt
#  sonst die hier gezeigten Standardwerte. Der Sinn der Datei: Wer zwanzig
#  Terminals aufsetzt, will nicht zwanzigmal dieselben Fragen beantworten.
#
#  Die Datei enthaelt bewusst KEINE Zugangsdaten. Server-Adresse, Terminal-ID
#  und Datenbankbenutzer holt sich das Geraet beim Koppeln selbst - deshalb
#  passt dieselbe Datei auf alle Geraete.
#
#  Format: Shell-Zuweisungen, die das Skript einliest.
# ===========================================================================

# --- Codequelle ------------------------------------------------------------
# Bleibt GIT_REPO leer, nimmt das Skript das 'origin' der Arbeitskopie, aus der
# es gerade gestartet wurde.
GIT_REPO=""
GIT_BRANCH="main"

# Wohin der Code gehoert. Der Webserver wird auf das Unterverzeichnis public/
# gerichtet.
ZIEL_VERZEICHNIS="/opt/zeiterfassung"

# --- Landeseinstellungen ---------------------------------------------------
# Pflicht, kein Beiwerk: Der Barcode-Scanner tippt wie eine Tastatur. Bei
# falschem Layout kommen 'y', 'z' und Sonderzeichen vertauscht an, und das
# Terminal bucht klaglos einen falschen Code.
TASTATURLAYOUT="de"

# Die Uhr im Terminal-Header laeuft nach der Systemzeit.
ZEITZONE="Europe/Berlin"

# --- Lokale Ausweichdatenbank ----------------------------------------------
# Fuer den Offline-Betrieb (Tabelle db_injektionsqueue). Das Passwort erzeugt
# das Skript selbst und legt es in config/geraet.local.php ab; bei einem
# zweiten Lauf wird das vorhandene wiederverwendet.
OFFLINE_DB_NAME="zeiterfassung_offline"
OFFLINE_DB_USER="zeiterfassung_offline"

# --- Kiosk (install_kiosk.sh, Stufe 4) -------------------------------------
# Eigener Benutzer fuer den Browser, ohne Passwort. Angemeldet wird er
# ausschliesslich vom Dienst zeiterfassung-kiosk.
KIOSK_BENUTZER="terminal"

# Startadresse des Browsers. Solange das Geraet nicht gekoppelt ist, zeigt
# terminal.php dort die Einrichtungsseite.
KIOSK_URL="http://localhost/terminal.php"

# auto    = Wayland (cage), wenn vorhanden, sonst X11
# wayland = cage erzwingen
# x11     = Xorg mit openbox erzwingen
KIOSK_ANZEIGE="auto"

# Leer = der erste gefundene Browser (Chromium bevorzugt, Firefox als
# Rueckfall). Sonst der volle Pfad zum Programm.
KIOSK_BROWSER=""

# abschalten = ein vorhandener Anmeldebildschirm wird deaktiviert; er wuerde
#              auf einem Hallenterminal nur den Kiosk verdecken.
# belassen   = nichts anfassen. Richtig, wenn das Skript versehentlich auf
#              einem Arbeitsplatzrechner laeuft.
KIOSK_ANMELDESCHIRM="abschalten"

# --- Peripherie (install_peripherie.sh, Stufe 5) ---------------------------
# usb    = Keyboard-Wedge. Der Leser tippt die Kennung wie eine Tastatur.
#          Keine Treiber, kein Dienst - der Normalfall.
# bridge = serieller Leser oder RC522: ein lokaler Dienst liest ihn aus und
#          reicht die Kennung per WebSocket an den Browser weiter.
# keine  = kein RFID; angemeldet wird ueber die Personalnummer.
RFID_VARIANTE="usb"

# Nur bei RFID_VARIANTE="bridge":
RFID_GERAET="/dev/ttyUSB0"
RFID_BAUD="9600"
RFID_WS_URL="ws://127.0.0.1:8765"
RFID_WS_VERZEICHNIS="/opt/rfid-ws"
RFID_WS_BENUTZER="rfidws"

# SPI wird nur auf einem Raspberry Pi und nur fuer den RC522 gebraucht.
# auto = einschalten, wenn ein Raspberry Pi erkannt wird.
SPI_AKTIVIEREN="auto"

# Drehung von Bild und Beruehrung: normal | links | rechts | kopf
# Erraten laesst sich das nicht - ein hochkant montierter Bildschirm sieht fuer
# das System aus wie jeder andere.
#
# Achtung: Unter cage (KIOSK_ANZEIGE="auto"/"wayland") kann das Skript nicht
# drehen - cage hat keinen Schalter dafuer. Es sagt dann, was in die Startzeile
# des Kernels gehoert. Unter X11 wird gedreht, sobald der Kiosk startet.
BILDSCHIRM_DREHUNG="normal"

# Leer = das erste erkannte Touchgeraet bzw. der erste verbundene Bildschirm.
TOUCH_GERAET=""
BILDSCHIRM_AUSGANG=""

# --- Selbsttest (selbsttest.sh, Stufe 6) -----------------------------------
# Er liest alle Werte von oben und braucht keine eigenen. Aufruf am Ende:
#     sudo ./selbsttest.sh              # mit Scan-Test (fragt nach)
#     sudo ./selbsttest.sh --ohne-scan  # nur die maschinellen Punkte
